# ContestDB Global Configuration
# Place a copy of this file named '.env' in the project root directory.

# Neon PostgreSQL Database Connection URL
# Format: postgresql://[user]:[password]@[neon-host]/[dbname]?sslmode=require
MIGRATION_DATABASE_URL=postgresql://migration_user:password@hostname/dbname?sslmode=require
API_DATABASE_URL=postgresql://api_user:password@hostname/dbname?sslmode=require
WORKER_DATABASE_URL=postgresql://worker_user:password@hostname/dbname?sslmode=require
# FastAPI Server Settings
HOST=0.0.0.0
PORT=8000

# Background Worker Settings
WORKER_ID=worker-1
WORKER_LEASE_SECONDS=60
WORKER_MAX_ATTEMPTS=3
